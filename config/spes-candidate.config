# Spes early bring-up options, based on the SM6225 postmarketOS reference.
# Keep the shared SoC baseline unchanged.
CONFIG_PSTORE_RAM=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_TOUCHSCREEN_EDT_FT5X06=y
# The Spes candidate uses the upstream edt-ft5x06 FT5452 binding instead.
# Disable the downstream vendor FocalTech driver to avoid duplicate probing
# and its unrelated vendor gesture implementation.
# CONFIG_TOUCHSCREEN_FTS is not set
